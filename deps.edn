{:paths ["src" "resources"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/mokuroku
        {:git/url "https://github.com/kotoba-lang/mokuroku.git"
         :git/sha "00f0bfcd134879712d4b102e6d1ea4da5e37ad7b"}
        io.github.kotoba-lang/mokuroku-ui
        {:git/url "https://github.com/kotoba-lang/mokuroku-ui.git"
         :git/sha "58f358c392b254c9c733a1ef13c55e9960710c3f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/clojure {:mvn/version "1.11.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/design-quality
                      {:git/url "https://github.com/kotoba-lang/design-quality.git"
                       :git/sha "fb766e2f79c088de05e289554c9de049e7909bd3"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :local {:override-deps {io.github.kotoba-lang/mokuroku {:local/root "../mokuroku"}
                          io.github.kotoba-lang/mokuroku-ui {:local/root "../mokuroku-ui"}
                          io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}
                          io.github.kotoba-lang/appkit {:local/root "../appkit"}
                          io.github.kotoba-lang/design-quality {:local/root "../design-quality"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
